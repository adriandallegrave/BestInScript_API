<Window x:Class="BestInScript.API.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        Title="BestInScript Overlay">

    <!--
        One outer card. The inner StackPanel is populated by OverlayWindow.xaml.cs,
        one row per visible script. Rows are added/removed as scripts toggle on/off
        and as pixel state changes. SizeToContent on the window means the card grows
        and shrinks to fit.
    -->
    <Border x:Name="CardBorder"
            CornerRadius="6"
            Background="#1A1A1A"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="10,6"
            Opacity="0.80"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
        <StackPanel Orientation="Vertical">

            <!--
                Drag-to-position chrome. Collapsed normally; EnterEditMode() shows it,
                drops WS_EX_TRANSPARENT so the pill takes the mouse, and lets the user
                drag the card. ✓ saves the position, ✕ reverts. Kept OUTSIDE RowsPanel
                so the 200 ms Refresh() rebuild never clobbers it.
            -->
            <Grid x:Name="EditChrome" Visibility="Collapsed" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="⠿ drag to move"
                           Foreground="#FFC107"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Button Grid.Column="1"
                        x:Name="EditSaveBtn"
                        Content="✓"
                        Click="EditSave_Click"
                        Width="22" Height="20"
                        Margin="0,0,4,0"
                        Padding="0"
                        Foreground="#3DDC84"
                        Background="#0F1216"
                        BorderBrush="#3DDC84"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Save this position"/>
                <Button Grid.Column="2"
                        x:Name="EditCancelBtn"
                        Content="✕"
                        Click="EditCancel_Click"
                        Width="22" Height="20"
                        Padding="0"
                        Foreground="#E85252"
                        Background="#0F1216"
                        BorderBrush="#E85252"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Cancel and keep the old position"/>
            </Grid>

            <StackPanel x:Name="RowsPanel" Orientation="Vertical" Grid.IsSharedSizeScope="True"/>
        </StackPanel>
    </Border>
</Window>
