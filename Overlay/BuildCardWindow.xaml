<Window x:Class="BestInScript.API.Overlay.BuildCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        Visibility="Hidden"
        Title="BestInScript Build Panel">

    <!--
        The build-guide panel: one card image plus its name, summoned by the cycle
        hotkey. Deliberately separate from the status pill — a paragon board is
        ~1000px and would drag the pill's rows across the screen.

        Unlike the pill there is no poll timer here: content only changes when the
        cycle key is pressed or the cards are edited in the web UI.
    -->
    <Border x:Name="CardBorder"
            CornerRadius="6"
            Background="#1A1A1A"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="10,6"
            Opacity="0.92"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
        <StackPanel Orientation="Vertical">

            <!--
                Drag-to-position chrome, mirroring OverlayWindow: collapsed normally;
                EnterEditMode() shows it and drops WS_EX_TRANSPARENT so the panel takes
                the mouse. ✓ saves the position, ✕ reverts.
            -->
            <Grid x:Name="EditChrome" Visibility="Collapsed" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="⠿ drag to move"
                           Foreground="#FFC107"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Button Grid.Column="1"
                        x:Name="EditSaveBtn"
                        Content="✓"
                        Click="EditSave_Click"
                        Width="22" Height="20"
                        Margin="0,0,4,0"
                        Padding="0"
                        Foreground="#3DDC84"
                        Background="#0F1216"
                        BorderBrush="#3DDC84"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Save this position"/>
                <Button Grid.Column="2"
                        x:Name="EditCancelBtn"
                        Content="✕"
                        Click="EditCancel_Click"
                        Width="22" Height="20"
                        Padding="0"
                        Foreground="#E85252"
                        Background="#0F1216"
                        BorderBrush="#E85252"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Cancel and keep the old position"/>
            </Grid>

            <TextBlock x:Name="TitleText"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>

            <!-- MaxWidth/MaxHeight are set from BuildPanelConfig at runtime: nothing
                 else bounds the window, which sizes itself to this image. -->
            <Image x:Name="CardImage"
                   Stretch="Uniform"
                   StretchDirection="DownOnly"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock x:Name="NotesText"
                       Foreground="#CCCCCC"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
