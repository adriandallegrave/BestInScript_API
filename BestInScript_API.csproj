<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- WPF for the on-screen overlay, WinForms only for System.Windows.Forms.Screen -->
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.OpenApi" Version="1.6.22" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
	</ItemGroup>

	<!--
    UseWindowsForms=true swaps in the WindowsDesktop implicit-usings set,
    which drops the Web SDK's implicit System.IO. Re-add it project-wide
    so existing files (ScriptRepository, etc.) continue to compile.
  -->
	<ItemGroup>
		<Using Include="System.IO" />
	</ItemGroup>

</Project>