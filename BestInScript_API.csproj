<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Release builds run without a console window (tray-only);
		     Debug keeps the console so dev logs stay visible. -->
		<OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>

		<!-- Embedded into the exe: Explorer / Start-menu shortcut icon. -->
		<ApplicationIcon>wwwroot\app.ico</ApplicationIcon>

		<!-- WPF for the on-screen overlay, WinForms for System.Windows.Forms.Screen
		     and the system-tray NotifyIcon -->
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.OpenApi" Version="1.6.22" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
	</ItemGroup>

	<!--
    The app csproj sits at the repo root, so the SDK's default **/*.cs glob
    would otherwise compile the test project's sources into the app.
  -->
	<ItemGroup>
		<Compile Remove="BestInScript.Tests/**" />
		<Content Remove="BestInScript.Tests/**" />
		<None Remove="BestInScript.Tests/**" />
		<EmbeddedResource Remove="BestInScript.Tests/**" />
	</ItemGroup>

	<!--
    UseWindowsForms=true swaps in the WindowsDesktop implicit-usings set,
    which drops the Web SDK's implicit System.IO. Re-add it project-wide
    so existing files (ScriptRepository, etc.) continue to compile.
  -->
	<ItemGroup>
		<Using Include="System.IO" />
	</ItemGroup>

</Project>