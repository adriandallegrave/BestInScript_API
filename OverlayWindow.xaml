<Window x:Class="BestInScript.API.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        Title="BestInScript Overlay">

    <!--
        One outer card. The inner StackPanel is populated by OverlayWindow.xaml.cs,
        one row per visible script. Rows are added/removed as scripts toggle on/off
        and as pixel state changes. SizeToContent on the window means the card grows
        and shrinks to fit.
    -->
    <Border x:Name="CardBorder"
            CornerRadius="6"
            Background="#1A1A1A"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="10,6"
            Opacity="0.80">
        <StackPanel x:Name="RowsPanel" Orientation="Vertical"/>
    </Border>
</Window>
