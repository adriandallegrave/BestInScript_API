<Window x:Class="BestInScript.API.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        Title="BestInScript Overlay">

    <Border x:Name="CardBorder"
            CornerRadius="6"
            Background="#1A1A1A"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="10,6"
            Opacity="0.80">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot"
                     Width="9" Height="9"
                     Margin="0,1,8,0"
                     VerticalAlignment="Center"
                     Fill="#888888"/>
            <TextBlock x:Name="StatusLabel"
                       Text="BestInScript · idle"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
